# Servidor
PORT=3000

# "production" ativa: log estruturado em JSON puro (sem pretty-print), cookie
# de refresh com o atributo Secure, e desliga o build de dev do Prisma. Deixe
# vazio/ausente em desenvolvimento local.
# NODE_ENV=production

# Nível mínimo de log (trace|debug|info|warn|error|fatal). Default: info.
# LOG_LEVEL=info

# Postgres (Prisma). Porta 5434 no host (não 5432) para não colidir com o
# Postgres de outro projeto local (ex.: o próprio AccessCore) rodando ao
# mesmo tempo. Em dev via `npm run dev`/`prisma migrate dev` no host, use
# localhost:5434; dentro do Docker Compose, o serviço `app` já aponta para
# `db:5432` (rede interna do compose, porta não remapeada).
DATABASE_URL=postgresql://horizonte:horizonte@localhost:5434/horizonte_saude

# Origens liberadas para CORS, separadas por vírgula. Deixe vazio/ausente para
# manter CORS fechado (adequado hoje, já que frontend e backend são servidos
# na mesma origem). Só é necessário se um frontend separado passar a consumir
# esta API futuramente.
# ALLOWED_ORIGINS=https://exemplo.com,https://outro-dominio.com

# URL base (com /api/v1) da instância do AccessCore usada como provedor de
# identidade. Local: suba o AccessCore separadamente (ver o repo dele) e
# aponte para http://localhost:8000/api/v1.
ACCESSCORE_URL=http://localhost:8000/api/v1

# Credenciais de um usuário admin no AccessCore, só usadas pelo script
# scripts/bootstrap-accesscore.ts (registra as permissões/role que o
# Horizonte Saúde precisa). Não são lidas pela aplicação em runtime.
# ACCESSCORE_ADMIN_EMAIL=admin@horizonte.dev
# ACCESSCORE_ADMIN_PASSWORD=

# URL pública desta aplicação, usada para montar os links de retorno do
# Stripe Checkout (success_url/cancel_url).
APP_BASE_URL=http://localhost:3000

# Stripe (modo sandbox/teste — nenhuma cobrança real). Pegue em
# https://dashboard.stripe.com/test/apikeys (chave secreta) e, para o
# webhook local, rode `stripe listen --forward-to localhost:3000/webhooks/stripe`
# (o comando imprime o STRIPE_WEBHOOK_SECRET correspondente).
STRIPE_SECRET_KEY=sk_test_...
STRIPE_WEBHOOK_SECRET=whsec_...

# E-mail transacional (confirmação/cancelamento de agendamento). Sem SMTP_HOST
# configurada, usa uma conta de teste do Ethereal criada automaticamente —
# nada é enviado de verdade, mas o fluxo roda de ponta a ponta e a URL de
# preview de cada e-mail aparece no log do servidor. Configure SMTP_* para
# usar um provedor real (em produção, recomendado: https://resend.com — SMTP
# em resend.com/docs/send-with-smtp, free tier cobre este projeto).
# SMTP_HOST=smtp.resend.com
# SMTP_PORT=587
# SMTP_SECURE=false
# SMTP_USER=resend
# SMTP_PASS=
# SMTP_FROM="Horizonte Saúde <nao-responda@horizonte-saude.dev>"
